# copy to voicelab/.env - never commit .env
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=                     # paste your Ollama Cloud key here
VOICELAB_CHAT_MODEL=gemma4:cloud
VOICELAB_PORT=8790
VOICELAB_TTS_KEY=                   # shared secret for the Modal TTS endpoint (modal secret create voicelab-tts VOICELAB_TTS_KEY=...)
QWEN_MODAL_URL=                     # printed by: modal deploy voicelab/modal_tts.py
KOKORO_MODAL_URL=
CHATTERBOX_MODAL_URL=
FISH_MODAL_URL=
VOICELAB_REF_WAV=                   # optional: short WAV to clone (chatterbox/fish)
VOICELAB_REF_TEXT=
COSYVOICE_MODAL_URL=
VOXCPM_MODAL_URL=
