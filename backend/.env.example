# ---- Pixel platform (copy to .env; never commit .env) ----
PIXEL_ENV=dev                      # dev | prod
PIXEL_TOKEN=                       # legacy device/portal token (P0); replaced by per-device tokens in P2
POSTGRES_PASSWORD=pixel
PIXEL_DOMAIN=localhost             # prod: pixel.example.com (Caddy gets the TLS cert)
PIXEL_PUBLIC_URL=                  # prod: https://pixel.example.com (firmware download URLs handed to devices)
PIXEL_BIND=0.0.0.0                 # prod: 127.0.0.1 so only Caddy reaches the brain/Postgres
PIXEL_ALLOW_DEV_LOGIN=0            # prod: 1 keeps the email/password login until Google sign-in is configured

# Ollama (Cloud): chat + memory models, web search
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
PIXEL_DEFAULT_CHAT_MODEL=gemma4:cloud
PIXEL_DEFAULT_MEMORY_MODEL=deepseek-v4-flash:cloud

# sessions: random 32+ char secret (openssl rand -hex 32)
SESSION_SECRET=change-me-please

# Google sign-in (leave empty until cutover; needs an OAuth client in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# dev login (P1) - only honoured when PIXEL_ENV=dev
DEV_LOGIN_EMAIL=owner@example.com
DEV_LOGIN_PASSWORD=change-me

# optional
SENTRY_DSN=
